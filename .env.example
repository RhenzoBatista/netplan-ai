OPENAI_API_KEY=
TAVILY_API_KEY=

# Optional tracing in LangSmith (execution traces, latency, tokens per run)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=netplan-ai

NETPLAN_COORDINATOR_MODEL=openai:gpt-4.1-mini
NETPLAN_SPECIALIST_MODEL=openai:gpt-5-nano
# NETPLAN_FALLBACK_MODEL=openai:gpt-5-nano

# AWS Bedrock instead of OpenAI (pip install -e ".[aws]")
