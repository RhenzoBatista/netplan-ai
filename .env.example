# NETPLAN_SPECIALIST_MODEL=bedrock_converse:us.anthropic.claude-haiku-4-5-20251001-v1:0
# NETPLAN_EMBEDDINGS_PROVIDER=bedrock
# NETPLAN_EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
# AWS_REGION=us-east-1
